# ==========================================
# Sunkey PaygEnergy - Device Bridge Config
# ==========================================

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payg_bridge
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# Redis & BullMQ
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Stellar / Soroban Network
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
CONTRACT_ID="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM"
# BRIDGE_OPERATOR_SECRET_KEY="S..."

# Device & IoT Communication
MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=sunkey/devices
DEVICE_COMMAND_TIMEOUT_SECONDS=30
SYNC_INTERVAL_SECONDS=60
RECONCILIATION_INTERVAL_SECONDS=300

# Hardware Cryptography & Security
DEVICE_HMAC_MASTER_KEY=dev-master-secret-key-must-be-32-chars-long!
KMS_PROVIDER=local
INTERNAL_API_KEY=dev-sunkey-internal-api-key-secret

# Mobile Money Integrations
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=
# MTN_SUBSCRIPTION_KEY=
# AIRTEL_CLIENT_ID=
