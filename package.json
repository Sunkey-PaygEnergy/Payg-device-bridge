{
  "name": "payg-device-bridge",
  "version": "1.0.0",
  "description": "Sunkey PaygEnergy device bridge, hardware token generator, on-chain sync, and payment ingestion engine",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx src/db/seed.ts"
  },
  "keywords": [
    "payg",
    "solar",
    "clean-energy",
    "stellar",
    "soroban",
    "openpaygo",
    "iot",
    "fastify"
  ],
